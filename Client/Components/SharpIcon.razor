    </svg>
}
else if (Name?.ToLowerInvariant() is "diamond-ceramic" or "ceramic" or "diamond" or "system-x")
{
    <svg class="sharp-icon @CssClass" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 3h12l4 6-10 12L2 9z"/>
        <line x1="2" y1="9" x2="22" y2="9"/>
        <polyline points="10 3 8 9 12 21 16 9 14 3"/>
    </svg>
}
else if (Name?.ToLowerInvariant() is "veteran-star" or "star" or "army" or "veteran")
{
    <svg class="sharp-icon @CssClass" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>

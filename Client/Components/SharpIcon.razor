        <line x1="6" y1="12" x2="2" y2="12"/>
        <line x1="12" y1="6" x2="12" y2="2"/>
        <line x1="12" y1="22" x2="12" y2="18"/>
    </svg>
}
else if (Name?.ToLowerInvariant() is "speedometer" or "gauge" or "performance")
{
    <svg class="sharp-icon @CssClass" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2v4"/>
        <path d="M4.93 4.93l2.83 2.83"/>

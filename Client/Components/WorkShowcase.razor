        public string ImageUrl { get; set; } = "";
        public string Vehicle { get; set; } = "";
        public string Product { get; set; } = "";
        public string SpecDetail { get; set; } = "";
        public string Warranty { get; set; } = "";
        public List<string> Pills { get; set; } = new();

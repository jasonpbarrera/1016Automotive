@namespace SmallBusinessSite.Client.Components
@inject IJSRuntime JS

<div class="showcase-container">
    <div class="showcase-header">
        <div class="badge-tag">
            <SharpIcon Name="crosshair" Size="16" />
            <span>AUTHENTIC FIELD WORK</span>
        </div>
        <h2 class="showcase-title">Mission Showcase</h2>
        <p class="showcase-subtitle">Real builds from our Cleveland, TN shop. Precision Geoshield window film, custom vinyl wraps, and System X certified ceramic protection.</p>
    </div>

    <!-- MARQUEE CAROUSEL -->
    <div class="marquee-wrapper">
        <div class="marquee-track">
            <!-- First set of real projects -->
            @foreach (var item in RealProjects)
            {
                <div class="marquee-card" @onclick="() => OpenModal(item)">
                    <div class="card-image-wrap">
                        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                        <div class="card-overlay">
                            <span class="inspect-btn">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                <span>Inspect</span>
                            </span>
                        </div>
                        <span class="category-badge @item.CategoryClass">@item.Category</span>
                    </div>
                    <div class="card-info">
                        <h4>@item.Title</h4>
                        <p class="card-specs">@item.ShortSpecs</p>
                    </div>
                </div>
            }
            <!-- Duplicate set for seamless continuous marquee loop -->
            @foreach (var item in RealProjects)
            {
                <div class="marquee-card" @onclick="() => OpenModal(item)">
                    <div class="card-image-wrap">
                        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                        <div class="card-overlay">
                            <span class="inspect-btn">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                <span>Inspect</span>
                            </span>
                        </div>
                        <span class="category-badge @item.CategoryClass">@item.Category</span>
                    </div>
                    <div class="card-info">
                        <h4>@item.Title</h4>
                        <p class="card-specs">@item.ShortSpecs</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- DIRECTORY ACTION BAR -->
    <div class="directory-actions">
        <button class="btn btn-tactical-outline" @onclick="ToggleDirectory">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>@(showDirectory ? "Hide Photo Directory" : $"Browse Full Photo Directory ({RealProjects.Count} Builds)")</span>
        </button>
        <a href="/contact" class="btn btn-tactical-gold">
            <SharpIcon Name="crosshair" Size="18" />
            <span>Request Your Custom Quote</span>
        </a>
    </div>

    <!-- FULL PHOTO DIRECTORY GRID (Toggleable) -->
    @if (showDirectory)
    {
        <div class="directory-section animate-fade-in">
            <div class="directory-filters">
                <button class="filter-chip @(activeFilter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>All Builds (@RealProjects.Count)</button>
                <button class="filter-chip @(activeFilter == "tint" ? "active" : "")" @onclick='() => SetFilter("tint")'>Window Tint</button>
                <button class="filter-chip @(activeFilter == "wrap" ? "active" : "")" @onclick='() => SetFilter("wrap")'>Vinyl Wraps</button>
                <button class="filter-chip @(activeFilter == "ceramic" ? "active" : "")" @onclick='() => SetFilter("ceramic")'>Ceramic Protection</button>
            </div>

            <div class="directory-grid">
                @foreach (var item in FilteredProjects)
                {
                    <div class="directory-card" @onclick="() => OpenModal(item)">
                        <div class="directory-img-wrap">
                            <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                            <span class="category-badge @item.CategoryClass">@item.Category</span>
                            <div class="directory-hover-overlay">
                                <span class="inspect-btn">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                    <span>Expand Build Specs</span>
                                </span>
                            </div>
                        </div>
                        <div class="directory-card-body">
                            <h4>@item.Title</h4>
                            <p class="desc">@item.Description</p>
                            <div class="spec-pills">
                                @foreach (var pill in item.Pills)
                                {
                                    <span class="spec-pill">@pill</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- LIGHTBOX / DETAIL MODAL -->
    @if (selectedProject != null)
    {
        <div class="lightbox-backdrop" @onclick="CloseModal">
            <div class="lightbox-dialog" @onclick:stopPropagation="true">
                <button class="lightbox-close" @onclick="CloseModal" aria-label="Close dialog">&times;</button>
                
                <div class="lightbox-content">
                    <div class="lightbox-media">
                        <img src="@selectedProject.ImageUrl" alt="@selectedProject.Title" />
                        <span class="lightbox-badge @selectedProject.CategoryClass">@selectedProject.Category</span>
                    </div>
                    
                    <div class="lightbox-details">
                        <div class="lightbox-tag">
                            <SharpIcon Name="crosshair" Size="14" />
                            <span>10:16 AUTOMOTIVE SPEC SHEET</span>
                        </div>
                        <h3>@selectedProject.Title</h3>
                        <p class="lightbox-desc">@selectedProject.Description</p>

                        <div class="specs-grid">
                            <div class="spec-cell">
                                <span class="label">Vehicle</span>
                                <span class="val">@selectedProject.Vehicle</span>
                            </div>
                            <div class="spec-cell">
                                <span class="label">Primary Service</span>
                                <span class="val">@selectedProject.Product</span>
                            </div>
                            <div class="spec-cell">
                                <span class="label">Specification</span>
                                <span class="val">@selectedProject.SpecDetail</span>
                            </div>
                            <div class="spec-cell">
                                <span class="label">Certified Partner</span>
                                <span class="val">@selectedProject.Warranty</span>
                            </div>
                        </div>

                        <div class="lightbox-actions">
                            <button class="nav-btn" @onclick="PrevProject" title="Previous Project">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                                <span>Previous</span>
                            </button>
                            <a href="/contact" class="btn btn-tactical-gold btn-sm">
                                <span>Inquire About This Service</span>
                            </a>
                            <button class="nav-btn" @onclick="NextProject" title="Next Project">
                                <span>Next</span>
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool showDirectory = false;
    private string activeFilter = "all";
    private ProjectItem? selectedProject = null;

    private void ToggleDirectory() => showDirectory = !showDirectory;
    private void SetFilter(string filter) => activeFilter = filter;
    private void OpenModal(ProjectItem item) => selectedProject = item;
    private void CloseModal() => selectedProject = null;

    private IEnumerable<ProjectItem> FilteredProjects =>
        activeFilter switch
        {
            "tint" => RealProjects.Where(p => p.CategoryType == "tint"),
            "wrap" => RealProjects.Where(p => p.CategoryType == "wrap"),
            "ceramic" => RealProjects.Where(p => p.CategoryType == "ceramic"),
            _ => RealProjects
        };

    private void NextProject()
    {
        if (selectedProject == null) return;
        var idx = RealProjects.IndexOf(selectedProject);
        selectedProject = RealProjects[(idx + 1) % RealProjects.Count];
    }

    private void PrevProject()
    {
        if (selectedProject == null) return;
        var idx = RealProjects.IndexOf(selectedProject);
        selectedProject = RealProjects[(idx - 1 + RealProjects.Count) % RealProjects.Count];
    }

    public class ProjectItem
